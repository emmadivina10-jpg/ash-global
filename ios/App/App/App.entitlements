<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manual signing (Codemagic) does NOT rewrite this value, and an App Store
	     provisioning profile only carries aps-environment=production. Keeping
	     "development" here fails the archive with code 65. -->
	<key>aps-environment</key>
	<string>production</string>

	<!-- Universal links: payment returns, storefront shares and OAuth callbacks
	     reopen the app instead of Safari. Requires an apple-app-site-association
	     file served from https://ashglogroup.company/.well-known/ -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:ashglogroup.company</string>
		<string>applinks:www.ashglogroup.company</string>
	</array>
</dict>
</plist>

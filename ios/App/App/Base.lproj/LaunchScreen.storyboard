        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17105"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="snD-IY-ifK">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="backgroundColor" red="0.03137254902" green="0.03137254902" blue="0.07058823529" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <subviews>
                            <imageView opaque="NO" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="ash-mark">
                                <rect key="frame" x="142.5" y="261" width="90" height="90"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="90" id="mark-w"/>
                                    <constraint firstAttribute="height" constant="90" id="mark-h"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="from" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="ash-from">
                                <rect key="frame" x="170" y="369" width="35" height="14"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="10"/>
                                <color key="textColor" white="0.65" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="ASH GLO" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="ash-name">
                                <rect key="frame" x="150" y="388" width="75" height="18"/>
                                <fontDescription key="fontDescription" type="system" weight="heavy" pointSize="14"/>
                                <color key="textColor" white="0.96" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="ash-safe"/>
                        <constraints>
                            <!-- Mark + caption form one group, centered as a whole.
                                 Group height = 90 (mark) + 18 + 14 + 5 + 18 = 145, so the
                                 mark's center sits 27.5pt above the true center. -->
                            <constraint firstItem="ash-mark" firstAttribute="centerX" secondItem="snD-IY-ifK" secondAttribute="centerX" id="mark-x"/>
                            <constraint firstItem="ash-mark" firstAttribute="centerY" secondItem="snD-IY-ifK" secondAttribute="centerY" constant="-27.5" id="mark-y"/>
                            <constraint firstItem="ash-from" firstAttribute="top" secondItem="ash-mark" secondAttribute="bottom" constant="18" id="mark-from"/>
                            <constraint firstItem="ash-from" firstAttribute="centerX" secondItem="snD-IY-ifK" secondAttribute="centerX" id="from-x"/>
                            <constraint firstItem="ash-name" firstAttribute="centerX" secondItem="snD-IY-ifK" secondAttribute="centerX" id="name-x"/>
                            <constraint firstItem="ash-name" firstAttribute="top" secondItem="ash-from" secondAttribute="bottom" constant="5" id="from-top"/>
                        </constraints>
